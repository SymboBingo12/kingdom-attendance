{
  "name": "kingdom-attendance",
  "productName": "Kingdom Hall Attendance",
  "version": "0.5.4",
  "description": "Kingdom Hall attendance counter: count on phones, finalize into an attendance video for M³",
  "main": "src/main.js",
  "type": "commonjs",
  "license": "MIT",
  "author": "Caio (SymboBingo12)",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "serve": "node src/cli.js",
    "test": "node --test \"test/*.test.js\"",
    "dist": "electron-builder"
  },
  "dependencies": {
    "bonjour-service": "^1.4.4",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "ffmpeg-static": "^5.2.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.symbobingo12.attendance",
    "productName": "Kingdom Hall Attendance",
    "files": [
      "src/**",
      "web/**",
      "assets/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe.LICENSE",
        "to": "LICENSES/ffmpeg.LICENSE.txt"
      },
      {
        "from": "web/steward/fonts/OFL.txt",
        "to": "LICENSES/NotoSans-OFL.txt"
      },
      {
        "from": "LICENSE",
        "to": "LICENSES/Kingdom-Hall-Attendance-MIT.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Kingdom-Hall-Attendance-Setup-${version}.exe"
    },
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SymboBingo12",
        "repo": "kingdom-attendance"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SymboBingo12/kingdom-attendance.git"
  }
}
